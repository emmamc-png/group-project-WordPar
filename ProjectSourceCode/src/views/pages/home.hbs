<div class="center-wrapper">
    <div class="page-box">
        <h1 class="top-center">WORD PAR</h1>
        <div class="top-right">
            <button class="btn btn-user">
                <a> <!-- To implment route to page game page -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="white" class="bi bi-person-fill" viewBox="0 0 16 16">
                            <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6"/>
                    </svg>
                </a>
            </button>
        </div>
        <div class="above-center">
            <div class="leaderboard-container">
                <h2 class="leaderboard-title">Leaderboard</h2>
                <div class="leaderboard-scroll"> <!-- To implement user data for the leader board -->
                    {{#each leaderboard}}
                        <div class="entry"> {{indexPlusOne @index}}. {{this.username}} - {{this.score}} pts</div>
                    {{/each}}
                </div>
                <p3>Current Position: #. {{currentUser.username}} - {{currentUser.score}} pts</p3> <!-- To implement user information and there current position -->
            </div>
        </div>
        <div class="logoContainer logo-position">
            <img src="/img/logoImage.png" class="logo"/>
        </div>
        <div class="below-center">
            <button class="play-btn" onclick="window.location.href='/game'">
                <a> <!-- To implment route to page settings page -->
                    <p class="play-text">PLAY</p>
                </a>
            </button>
        </div>
        <div>
            <!-- Button to display modal -->
            <div  class="how-to-play">
                <!-- Trigger Button -->
                    <button class='btn how-to-btn' id="openModal">How to Play</button>
            </div>

            <!-- Modal Overlay -->
            <div id="customModal" class="modal-overlay">
                <div class="modal-box">
                    <button class="close-btn" id="closeModal">&times;</button>
                    <h2>How to Play</h2>
                    <div class="modal-body">
                        <p>
                            REPLACE WITH INSTRUCTIONS ON HOW TO PLAY THE GAME
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>