<h1 class = "registerTitle">WORD PAR</h1>
<div class="logoContainer">
    <img src="/img/logoImage.png" class="logo"/>
</div>
<form class = "formBody" method = "POST" action="/registration"> 
    <div>
        <input name="username" class="usernameForm" type = "text" id = "username" placeholder="Username" maxlength="50" required/>
    </div>
    <div>
        <input name="email" class="usernameForm" type = "email" id = "email" placeholder="Email" maxlength="100" required/>
    </div>
    <div>
        <input name="password"class="usernameForm" type = "password" id ="password" placeholder="Password" required/>
    </div>
    <div>
        <input name="password_retype" class="passwordForm" type = "password" id ="password_retype" placeholder="Retype Password" oninput="checkPasswords()" required/>
    </div>
    <br>
    <div>
        <input class="btn custom-btn" type = "submit" value = "REGISTER" />
    </div>
    <br>
</form>

<p class = "text-center">Already have an acccount<a href="/login"> login!</a></p>
<div class="container-fluid w-25">
    {{>message}}
</div>