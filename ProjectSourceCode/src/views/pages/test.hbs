<!--Too implemnt results page, use a button to test the pop up -->
<style>
    /* Modal overlay */
.modal {
  display: none; /* hidden by default */
  position: fixed; /* stays in place */
  top: 0; left: 0;
  width: 100%; height: 100%;
  background-color: rgba(0,0,0,0.2); /* semi-transparent backdrop */
  justify-content: center;
  align-items: center;
}

/* Modal content box */
.modal-content1{
  background: rgba(0,0,0,0);
  position: absolute;
  padding: 20px;
  border: none;
  width: 400px;
  max-width: 90%;
  top: 25%;
}

.modal-textbox{
    background: #b34dac;
    padding: 20px;
    border: none;
    border-radius: 4px;
}

.result-title{
    color: #934790;
    font-family: 'Coiny', sans-serif;
    text-align: center;
    text-transform: uppercase;
    font-size: 40px;
    text-shadow: rgba(0,0,0,0.2);
}

/* Colors
    #934790
    #b34dac
    #6A0066
*/
.text-center{
    text-align: center;
}
</style>

<!-- Trigger button -->
<button id="openModalBtn">Open Modal</button>

<!-- Modal structure -->
<div id="resultModal" class="modal">
  <div class="modal-content1 w3-modal-content w3-animate-zoom">
    <h2 class="result-title">Results</h2>
    <div class="modal-textbox">
        <div class="leaderboard-container2">
            <h2 class="leaderboard-title">Leaderboard</h2>
            <div class="leaderboard-scroll">
                
            </div>
        </div>
        <p class="text-center">Score</p>
    </div>
  </div>
</div>

<script>
const resultModal = document.getElementById("resultModal");
const openBtn = document.getElementById("openModalBtn");

openBtn.addEventListener("click", () => {
  resultModal.style.display = "flex"; // show modal
});
</script>