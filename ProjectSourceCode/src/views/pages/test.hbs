<!--Too implemnt results page, use a button to test the pop up -->
<style>
    /* Modal overlay */
.modal {
  display: none; /* hidden by default */
  position: fixed; /* stays in place */
  top: 0; left: 0;
  width: 100%; height: 100%;
  background-color: rgba(0,0,0,0.2); /* semi-transparent backdrop */
  justify-content: center;
  align-items: center;
}

/* Modal content box */
.modal-content1{
  background: rgba(0,0,0,0);
  position: absolute;
  padding: 20px;
  border: none;
  width: 400px;
  max-width: 90%;
  top: 10%;
}

.modal-textbox{
    background: #934790;
    padding: 1px;
    border: none;
    border-radius: 4px;
}

.result-title{
    color: #934790;
    font-family: 'Coiny', sans-serif;
    text-align: center;
    text-transform: uppercase;
    font-size: 40px;
    text-shadow: rgba(0,0,0,0.2);
}

/* Colors
    #934790
    #b34dac
    #6A0066
*/
.text-center{
    text-align: center;
}

.results-leaderboard-container {
  width: 300px;
  margin: 20px auto;
  background-color: rgba(255,255,255,0.6);
  border-radius: 8px;
  box-shadow: 0 0 10px rgba(0,0,0,0.2);
  text-align: center;
  padding-bottom: 5px;
}
.results-leaderboard-title{
  padding-top: 10px;
}
  
.results-leaderboard-scroll {
  max-height: 200px; /* Controls visible height */
  overflow-y: auto;  /* Enables vertical scrolling */
  margin-top: 1rem;
  padding-top: 5px;
}

.return-home-btn{
  position: relative;
  border: none;
  border-radius: 4px;
  background-color: #b34dac;
  margin-top: 5px;
  color: #000;
  font-size: 20px;
  width: 200px;
  height: 50px;
  left: 20%;
  transition: ease 0.2s;
}

.return-home-btn:hover{
  transform: scale(1.05);
  background-color: #6A0066;
}
</style>

<!-- Trigger button -->
<button id="openModalBtn">Open Modal</button>

<!-- Modal structure -->
<div id="resultModal" class="modal">
  <div class="modal-content1 w3-modal-content w3-animate-zoom">
    <h2 class="result-title">Results</h2>
    <div class="modal-textbox">
        <div class="results-leaderboard-container">
            <h2 class="results-leaderboard-title">Leaderboard</h2>
            <div class="results-leaderboard-scroll"> <!-- To implement user data for the leader board -->
                {{#each leaderboard}}
                  <div class="entry"> {{indexPlusOne @index}}. {{this.username}} - {{this.score}} pts</div>
                {{/each}}
            </div>
            {{#if currentUser.position}} 
              <p3>Resulting Score: {{currentUser.position}}. {{currentUser.username}} - {{currentUser.score}} pts</p3> <!-- To implement user information and there current position -->
            {{else}}
                <p3>Current Position: Unranked. {{currentUser.username}} - {{currentUser.score}} pts</p3>
            {{/if}}
        </div>
    </div>
    <button class="return-home-btn" onclick="window.location.href='/home'">Return Home</button>
  </div>
</div>

<script>
  const resultModal = document.getElementById("resultModal");
  const openBtn = document.getElementById("openModalBtn");

  openBtn.addEventListener("click", () => {
    resultModal.style.display = "flex"; // show modal
  });
</script>