<script>
    const buttonContainer = document.getElementById('buttonContainer');

    // Log the previous key to make the color change
    let prevKey = "";

    // Store the user's inputs
    let buttonInputs = [];

    // See if the user's done with current guess
    let room = true;

    // Update the user's guess on the screen
    function updateGuess(buttonInputs) {
        // Your chosen JavaScript code from above would go here
        // For example, using forEach():
        const guessDiv = document.getElementById("guess");

        let htmlContent = "<div id= 'letters'>";
        buttonInputs.forEach(item => {
            htmlContent += "<div class= 'character rounded'>";
            htmlContent += `${item}`;
            htmlContent += "</div>";
        });
        htmlContent += "</div>";
        guessDiv.innerHTML = htmlContent;

        const clearbtnDiv = document.getElementById("clearbtn");
        let htmlContent2 = "<button id='clear' type='button' class='game btn btn-outline-secondary btn-lg' value='Clear'>Clear</button>"
        clearbtnDiv.innerHTML = htmlContent2;

        // Call the button function every time the clear is pressed (from the virtual keyboard)
        clearbtnDiv.addEventListener('click', buttonPressed);
    }

    // Get the key from the user and store in array
    function buttonPressed(event) {
        // console.log(room)
        if (room)
        {   
            // console.log(prevKey)
            if (prevKey) {
                prevKey.classList.remove('simulate-btn-hover');
            }
            // console.log(event)
            const correctKey = document.querySelector(`#${event.target.id}`)
            // console.log(correctKey)
            prevKey = correctKey
            correctKey.classList.add('simulate-btn-hover');

            // console.log(event.target)
            if (event.target.tagName === 'BUTTON') {
                if(event.target.id == 'enter') {
                //    console.log('im here')
                updateGuess(buttonInputs);
                    room = false;
                //    console.log(room)
                submitGuess();
                }
                else if (event.target.id === 'back') {
                    buttonInputs.pop();
                    updateGuess(buttonInputs);
                    // console.log(buttonInputs);
                }
                else {
                    buttonInputs.push(event.target.value);
                    updateGuess(buttonInputs);
                    // console.log(buttonInputs);
                }
            }
        }
        else {
            if (event.target.tagName === 'BUTTON') {
                 if (event.target.id === 'clear') {
                    // console.log(buttonInputs);
                    buttonInputs.length = 0;
                    // console.log(buttonInputs);
                    const guessDiv = document.getElementById("letters");
                    const clearbtn = document.getElementById("clear");
                    if (guessDiv) {
                        guessDiv.remove();
                    }
                    if (clearbtn) {
                        clearbtn.remove();
                    }
                    room = true;
                }
            }
            // console.log('Guess Set')
        }
    };

    // Call the button function every time a key is pressed (from the virtual keyboard)
    buttonContainer.addEventListener('click', buttonPressed)

    // Call the correct key when the user inputs the value from the keyboard itself
    document.addEventListener("keydown", function(event) { 
        if ((event.key.length === 1 && event.key.match(/[a-z]/i)) || event.key == 'Enter' || event.key == 'Backspace') {
            event.preventDefault();
            let keyTap;

            if (room) {
                if (event.key == 'Enter') {
                    keyTap = { target: {tagName: 'BUTTON', value: event.key, id: 'enter'} };
                    submitGuess();
                }
                else if (event.key == 'Backspace') {
                    keyTap = { target: {tagName: 'BUTTON', value: event.key, id: 'back'} };
                }
                else {
                    keyTap = { target: {tagName: 'BUTTON', value: event.key, id: event.key} };
                }
            }
            else {
                // console.log("here")
                if (event.key === 'Backspace') {
                    keyTap = { target: {tagName: 'BUTTON', value: event.key, id: 'clear'} }
                }
            }
            // console.log(event.keyCode);
            // console.log(keyTap);

            // Record user's input
            buttonPressed(keyTap);
        }
    });

    async function submitGuess() {
    const guess = buttonInputs.join("");

    try {
        const response = await fetch("/api/submitGuess", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                userInput: guess,
                gameID: window.currentGameID || null
            })
        });

        const data = await response.json();

        console.log("Server response:", data);

        if (data.success) {
            window.currentGameID = data.gameID; 
            console.log("Guess saved, new gameID:", window.currentGameID);
        } else {
            console.error("Backend error:", data.error);
        }
    } catch (err) {
        console.error("Failed to send guess:", err);
    }
}

  

</script>
