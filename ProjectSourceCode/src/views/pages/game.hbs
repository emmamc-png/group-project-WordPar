<div class="row">
    <div class="col-7">
        <div class="row game-info">
            <div id="points" class="col-1">
                <div id="point">
                    Points: 
                </div>
                 <span id="points-value">100</span>
            </div>
            <div id="category" class="col-6"> 
                <span id="category-value">...</span>
            </div>
            <div id="user-score" class="col-1">
                <div id="strokes">
                    Strokes: 
                </div>
                <span id="strokes-value">0</span>
            </div>
        </div>
        <div id="actual-game" class="row">
            <div id="top-left-game" class="row">
                <br>
                <div id="clearbtn"></div>
                <div id="max-length"></div>
                <br>
                <div id="guess"></div>
                <div id="guessContainer"></div>
                <br>
                <br>
            </div>
        </div>
        {{!-- <div style="border-style: dashed none none none; border-width: 2px; position:absolute; width:65%;"></div> --}}
        <div id="buttonContainer" class="row">
            <div class="keyboard_row">
                <button id="q" type="button" class="game btn btn-outline-secondary btn-lg" value="q">Q</button>
                <button id="w" type="button" class="game btn btn-outline-secondary btn-lg" value="w">W</button>
                <button id="e" type="button" class="game btn btn-outline-secondary btn-lg" value="e">E</button>
                <button id="r" type="button" class="game btn btn-outline-secondary btn-lg" value="r">R</button>
                <button id="t" type="button" class="game btn btn-outline-secondary btn-lg" value="t">T</button>
                <button id="y" type="button" class="game btn btn-outline-secondary btn-lg" value="y">Y</button>
                <button id="u" type="button" class="game btn btn-outline-secondary btn-lg" value="u">U</button>
                <button id="i" type="button" class="game btn btn-outline-secondary btn-lg" value="i">I</button>
                <button id="o" type="button" class="game btn btn-outline-secondary btn-lg" value="o">O</button>
                <button id="p" type="button" class="game btn btn-outline-secondary btn-lg" value="p">P</button>
            </div>
            <div class="keyboard_row">
                <button id="a" type="button" class="game btn btn-outline-secondary btn-lg" value="a">A</button>
                <button id="s" type="button" class="game btn btn-outline-secondary btn-lg" value="s">S</button>
                <button id="d" type="button" class="game btn btn-outline-secondary btn-lg" value="d">D</button>
                <button id="f" type="button" class="game btn btn-outline-secondary btn-lg" value="f">F</button>
                <button id="g" type="button" class="game btn btn-outline-secondary btn-lg" value="g">G</button>
                <button id="h" type="button" class="game btn btn-outline-secondary btn-lg" value="h">H</button>
                <button id="j" type="button" class="game btn btn-outline-secondary btn-lg" value="j">J</button>
                <button id="k" type="button" class="game btn btn-outline-secondary btn-lg" value="k">K</button>
                <button id="l" type="button" class="game btn btn-outline-secondary btn-lg" value="l">L</button>
            </div>
            <div class="keyboard_row">
                <button id="enter" type="button" class="game btn btn-outline-secondary btn-lg" value="Enter">ENTER</button>
                <button id="z" type="button" class="game btn btn-outline-secondary btn-lg" value="z">Z</button>
                <button id="x" type="button" class="game btn btn-outline-secondary btn-lg" value="x">X</button>
                <button id="c" type="button" class="game btn btn-outline-secondary btn-lg" value="c">C</button>
                <button id="v" type="button" class="game btn btn-outline-secondary btn-lg" value="v">V</button>
                <button id="b" type="button" class="game btn btn-outline-secondary btn-lg" value="b">B</button>
                <button id="n" type="button" class="game btn btn-outline-secondary btn-lg" value="n">N</button>
                <button id="m" type="button" class="game btn btn-outline-secondary btn-lg" value="m">M</button>
                <button id="back" type="button" class="game btn btn-outline-secondary btn-lg" value="Back">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-backspace" viewBox="0 0 16 16">
                        <path d="M5.83 5.146a.5.5 0 0 0 0 .708L7.975 8l-2.147 2.146a.5.5 0 0 0 .707.708l2.147-2.147 2.146 2.147a.5.5 0 0 0 .707-.708L9.39 8l2.146-2.146a.5.5 0 0 0-.707-.708L8.683 7.293 6.536 5.146a.5.5 0 0 0-.707 0z"/>
                        <path d="M13.683 1a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-7.08a2 2 0 0 1-1.519-.698L.241 8.65a1 1 0 0 1 0-1.302L5.084 1.7A2 2 0 0 1 6.603 1zm-7.08 1a1 1 0 0 0-.76.35L1 8l4.844 5.65a1 1 0 0 0 .759.35h7.08a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1z"/>
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <div class="col-5" style="border: 2px none black;">
        <div class="semicircle"></div>
        <div class="circle"></div>
        <div class="rectangle"></div>
        <div class="triangle-right"></div>
        <div class="vl"></div>
        <div class="wrapper">
            <div class="ball">
                <div class="texture"></div>
            </div>
        </div>
        <canvas id="myCanvas" width="300" height="750">
            Sorry, your browser does not support canvas.
        </canvas>
        <script>
        const canvas = document.getElementById("myCanvas");
        const ctx = canvas.getContext("2d");
        ctx.beginPath();
        ctx.moveTo(0, 445);
        ctx.quadraticCurveTo(190, 15, 30, 0);
        ctx.stroke();
        </script>
        <h1 id="golf-logo" class="top-center">WORD PAR</h1>
    </div>

    <div id="top-right-game" class="col-12">
        <button id="exit-button" class="btn btn-danger" onclick="exitGame()">Exit</button>
    </div>
</div>