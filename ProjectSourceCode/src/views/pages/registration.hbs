<h1 class = "registerTitle">WORD PAR</h1>
<div class="logoContainer">
    <img src="/img/logoImage.png" class="logo"/>
</div>
<form class = "formBody" method = "POST" action="/registration"> 
    <div>
        <input class="usernameForm" type = "text" id = "username" placeholder="Username"/>
    </div>
    <div>
        <input class="usernameForm" type = "text" id = "email" placeholder="Email"/>
    </div>
    <div>
        <input class="usernameForm" type = "password" id ="password" placeholder="Password"/>
    </div>
    <div>
        <input class="passwordForm" type = "password" id ="password" placeholder="Retype Password"/>
    </div>
    <br>
    <div>
        <input class="btn custom-btn" type = "submit" value = "REGISTER" />
    </div>
    <br>
</form>

<p class = "text-center">Already have an acccount<a href="/login"> login!</a></p>
<div class="container-fluid w-25">
    {{>message}}
</div>