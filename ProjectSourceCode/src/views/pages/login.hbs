<h1 class = "loginTitle">WORD PAR</h1>
<div class="logoContainer">
    <img src="/img/logoImage.png" class="logo"/>
</div>
<form class = "formBody" method = "POST" action="/login"> 
    <div>
        <input class="usernameForm" type = "text" id = "username" placeholder="Username"/>
    </div>
    <div>
        <input class="passwordForm" type = "password" id ="password" placeholder="Password"/>
    </div>
    <br>
    <div>
        <input class="btn custom-btn" type = "submit" value = "LOGIN" />
    </div>
    <br>
</form>

<p class = "text-center">Don't have an acccount<a href="/registration"> register!</a></p>
{{>message}}